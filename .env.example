# ---- backend -------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DATABASE_URL=postgresql+asyncpg://saas:saas@db:5432/saas
APP_REDIS_URL=redis://redis:6379/0
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000
APP_COOKIE_SECURE=false
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=30
APP_BILLING_WEBHOOK_SECRET=mock-webhook-secret
APP_LOG_JSON=true

# ---- frontend ------------------------------------------------------------
# Server-side URL the Next.js route handlers and middleware use to reach the API
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_APP_NAME=SaaS Starter Kit

# ---- compose -------------------------------------------------------------
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas
