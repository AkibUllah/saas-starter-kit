APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
# Postgres in compose; SQLite works for a quick local run:
# APP_DATABASE_URL=sqlite+aiosqlite:///./saas.db
APP_DATABASE_URL=postgresql+asyncpg://saas:saas@localhost:5432/saas
# Optional; without it rate limiting falls back to in-process memory
APP_REDIS_URL=redis://localhost:6379/0
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000
APP_COOKIE_SECURE=false
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=30
APP_BILLING_WEBHOOK_SECRET=mock-webhook-secret
APP_LOG_JSON=false
APP_LOG_LEVEL=INFO
